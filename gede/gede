  my($AbsDateiname,$HTMLname,$z_HTML) = @_;
  my($Message,$Status,$l);
                #&DumpArray($z_HTML,"\nz_HTML"); # exit 7;

  $l = chomp(@$z_HTML);
                #&Dprint("\nchomp l $l\n"); # exit 7;
