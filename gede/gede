    } # Fehler in mkdir

  if ( not (-w $OutDirname) ) {
    $Message="Neu angelegtes Verzeichnis »$cf$OutDirname$cr«: Keine Schreibrechte.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   In »$cf$OutDirname$cr« sollen die erstellten web2.0 HTML- usw. -Dateien gespeichert werden.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n                     Eventuell werden die Schreibrechte für neu angelegte Verzeichnisse";
      $Message .= "\n                     automatisch entfernt, oder das Skript muss umprogrammiert werden.";
      $Message .= "\n           Maßnahme: Mit Mitteln des Betriebssystems prüfen, ob Schreibrechte automatisch entzogen werden.";
      $Message .= "\n                         Unixoide-Systeme: umask prüfen.";
      }
    &Error($Message); # &Exit(1);
    } # nicht beschreibbar

  if ( not chdir($OutDirname) ) {
    $PerlErrorMessage = "$!";
    $Message = "Wechsel in das Unterverzeichnis »$cf$OutDirname$cr« nicht möglich.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   In »$cf$OutDirname$cr« sollen die erstellten HTML usw. -Dateien gespeichert werden.";
      }
    if ( $O{'details'} > 2 ) { $Message .= "\n                       Perl-Error-Message: $PerlErrorMessage"; } 
    &Error($Message); # &Exit(1);
    } # cd gescheitert

  $CurrentDir = File::Spec->rel2abs(".","");
  if ( $O{'details'} > 3 ) { print("$cdn→→→$cr $CurrentDir\n"); }
  
  # Medien-Unterverzeichnis anlegen

  $Ergebnis = mkdir($MediaDirname);
  $PerlErrorMessage = "$!";
