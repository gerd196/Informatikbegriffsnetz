  if ( not $Ergebnis ) {
    $Message = "Verzeichnis »$cf$MediaDirname$cr« konnte nicht angelegt werden.";
    if ( $O{'details'} > 0 ) {
      $Message .= $cr;
      $Message .= "\n                     In »$cf$MediaDirname$cr« sollen die in den .docx-Dateien enthaltenen Medien-Dateien (Bilder usw.) gespeichert werden.";
      $Message .= "\n           Maßnahme: Mit Mitteln des Betriebssystems prüfen, warum das Anlagen des Verzeinisses »$cf$MediaDirname$cr« gescheitert ist.";
      $Message .= "\n                     Z. B. Schreib- und Leserechte prüfen sowie eventuell vorhandene Dateien bzw. Verzeichnisse »$cf$MediaDirname$cr«.";
      }
    if ( $O{'details'} > 2 ) { $Message .= "\n                       Perl-Error-Message: $PerlErrorMessage"; } 
    &Error($Message); # &Exit(1);
    } # mkdir ging nicht

  if ( not (-w $MediaDirname) ) {
    $Message="Neu angelegtes Verzeichnis »$cf$MediaDirname$cr«: Keine Schreibrechte.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                     In »$cf$MediaDirname$cr« sollen die in den .docx-Dateien enthaltenen Medien-Dateien (Bilder usw.) gespeichert werden.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n                     Eventuell werden die Schreibrechte für neu angelegte Verzeichnisse automatisch entfernt,";
      $Message .= "\n                     oder das Skript muss umprogrammiert werden.";
      $Message .= "\n           Maßnahme: Mit Mitteln des Betriebssystems prüfen, ob Schreibrechte automatisch entzogen werden.";
      $Message .= "\n                         Unixoide-Systeme: umask prüfen.";
      }
    &Error($Message); # &Exit(1);
    } # Kein Schreibrecht

  $CurrentDir = File::Spec->rel2abs(".","");
  $S{'PandocMediaDir'} = $CurrentDir;
  $UpDir = File::Spec->updir();
  if ( not chdir($UpDir) ) {
    $Message = "Wechsel in das übergeordnete Verzeichnis von »$cf$CurrentDir$cr nicht möglich.";
    &Error($Message); # &Exit(1);
    } # cd .. ging nicht

  $CurrentDir = File::Spec->rel2abs(".","");
  if ( $O{'details'} > 3 ) { print("$cu←←←$cr $CurrentDir\n"); }
  return;
  } # sub ErstelleOutDirs #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

