sub ProcessPandocHTML #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &ProcessPandocHTML($AbsDateiname,$HTMLname,$z_HTML);
    # Legt $z_HTML in %HTMLbyFilename ab und speichert, wenn -H gesetzt ist, 
    # $z_HTML in der Datei mit Namen $HTMLname im aktuellen Verzeichnis.
