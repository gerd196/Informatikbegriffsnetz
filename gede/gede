    # Entfernt alle Tag-Elemente, d. h. alle Elemente die mit < beginnen aus @tokenisiertesHTML
    # Liefert die Content-Elemente als @TokenOhneTags zurück
  my(@TokenisiertesHTML) = @_;
  my(@TokenOhneTags) = ();
  my($t);

  foreach $t (@TokenisiertesHTML) {
    next if ( $t =~ /^</ );
    push(@TokenOhneTags,$t);
    }
  return @TokenOhneTags;
  } # sub EntferneTags #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

