sub AnalysiereBegriffe #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &AnalysiereBegriffe();
    # Analysiert syntaktisch und (teilweise) semantisch die Inhalte der übernommenen Begriffe in
    # %BegriffeByBegriffsId.
    # Speichert akzeptierte Begriffe in %BegriffeByBegriffsIdA.
    # Zusätzliche werden %BegriffeZuBegriffsIds, %EnglischZuBegriffsIds, %SynonymeZuBegriffsIds,
    # %ViewsFlachZuBegriffsIds und %ViewsBaumZuBegriffsIds (?) befüllt.
  my($BegriffsId,$z_BegriffA);
  my($Begriff,$Englisch,$Synonym,$View);
  my($z_EnglischListe) = [];
  my($z_SynonymeListe) = [];
  my($z_ViewsFlachListe) = [];

  foreach $BegriffsId (sort(keys(%BegriffeByBegriffsId))) {
    $z_BegriffA = &AnalysiereBegriff($BegriffsId);
    next unless ( defined($z_BegriffA) ); # Begriff nicht übernehmen
                #&DumpHash($z_BegriffA,"\nBegriffA"); # exit 7;
    $BegriffeByBegriffsIdA{$BegriffsId} = $z_BegriffA;

    $Begriff = $$z_BegriffA{'Begriff'};
                #&Dprint("»$BegriffsId«: »$Begriff«");
    &PushToHash(\%BegriffeZuBegriffsIds,$Begriff,$BegriffsId);
    $z_EnglischListe = $$z_BegriffA{'EnglischListe'};
    foreach $Englisch (@$z_EnglischListe) { &PushToHash(\%EnglischZuBegriffsIds,$Englisch,$BegriffsId); }
    $z_SynonymeListe = $$z_BegriffA{'SynonymeListe'};
    foreach $Synonym (@$z_SynonymeListe) { &PushToHash(\%SynonymeZuBegriffsIds,$Synonym,$BegriffsId); }
    $z_ViewsFlachListe = $$z_BegriffA{'ViewsFlachListe'};
    foreach $View (@$z_ViewsFlachListe) { &PushToHash(\%ViewsFlachZuBegriffsIds,$View,$BegriffsId); }
    }

  return;
  } # sub AnalysiereBegriffe #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub AnalysiereBegriff #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $z_BegriffA = &AnalysiereBegriff($BegriffsId);
    # Analysiere syntaktisch und teilweise semantisch den in $z_Begriff übergebenen Begriff
    # Modifiziert eventuell das eine oder andere Feld.
    # Der analysierte (und eventuell modifizierte) Begriff wird zurückgegeben.
    # Wenn der Begriff in $z_Begriff fehlerhaft ist, wird undef zurückgegeben.
    # Falls etwas nicht wie erwartet ist, werden geeignete Meldungen ausgegeben.
  my($BegriffsId) = @_;
  my($Dateiname,$Begriff,$Englische,$Synonyme,$Freigaben,$Freigabedatum,$ZusatzViews);
  my($z_Begriff);
  my(%Begriff);
  my(%BegriffA) = ();
  my($z_EnglischListe) = [];
  my($z_SynonymeListe) = [];
  my($z_ViewsFlachListe) = [];
  my($Status,$Key,$Wert,$View);

  $S{'aktuelleBegriffsId'} = $BegriffsId;
  ($Status,$View) = &AnalysiereBegriffsId($BegriffsId);
