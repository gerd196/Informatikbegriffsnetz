      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: Schreibrechte für »$cf$DirName$cr«erteilen.";
      }
    $Message .= &AddE3($DirName);
    $Message .= "\n                   Dazu muss in das Verzeichnis »$cf$DirName$cr« geschrieben werden können.";
    &Error($Message); # &Exit(1);
    } #  Eingabeverzeichnisnamen gefunden: nicht beschreibbar

  if ( not (-x $DirName) ) { # Eingabeverzeichnisnamen gefunden: nicht scanbar
    $Message = "Dateinamen im Verzeichnis »$cf$DirName in »$cf$CurrentDir$cr« nicht ermittelbar.";
    if ( $O{'details'} > 0 ) {
      $Message .= $cr;
      $Message .= "\n                   Die Dateinamen in »$cf$DirName$cr« müssen ermittelbar sein, damit diese";
      $Message .= "\n                   verarbeitet werden können.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: Suchrechte (Unix usw: x) für »$cf$DirName$cr« erteilen.";
      }
    $Message .= &AddE3($DirName);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n                   Dazu sollte der Inhalt des Verzeichnisses »$cf$DirName$cr« ermittelt werden können.";
      }
    &Error($Message); # &Exit(1);
    } #  Eingabeverzeichnisnamen gefunden: nicht scanbar

  return;
  } # CheckInputDir

sub ErstelleOutDirs #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage  &ErstelleOutDirs();
    # Erstellt im aktuelle Verzeichnis das Verzeichnis $O{'OutputDir'} und die darunter erforderlichen Verzeichnisse
    # Falls der Name $O{'OutputDir'} bereits existiert wird er in $O{'OutputDir'}.bak umbenannt.
    # Der absolute Pfadnamen des erstellten Verzeichnisses wird in $S{'OutDir'} abgelegt.
    # Falls irgendetwas schiefgeht, wird eine geeignete Fehlermeldung ausgegeben und die Ausführung mit einem
    # Fehlercode beendet.
  my($Ergebnis,$PerlErrorMessage,$CurrentDir,$UpDir,$err);
  my($Message) = "$ScriptName: Internal error ErstelleOutDirs: Should never be printed";
  my($OutDirname) = $O{'OutputDir'};
  my($BakOutDirname) = $OutDirname . ".bak";
  my($MediaDirname) = "media";

  if ( -e $BakOutDirname ) { 
    remove_tree($BakOutDirname,{error => \$err});
                #&Dprint("BakOutDirname: $BakOutDirname, err $err"); # exit 7;
                #&DumpArray($err,"\nerr");  #exit 7;
    if ( @$err ) { # Fehler beim Löschen
      $Message = "Vorhandener Verzeichnisbaum »$cf$BakOutDirname$cr« konnte nicht gelöscht werden.";
      if ( $O{'details'} > 0 ) { $Message .= $cr;
        $Message .= "\n         Maßnahme: Mit Mitteln des Betriebssystems Verzeichnis »$cf$BakOutDirname$cr« löschen.";
        $Message .= "\n                   Danach $ScriptName erneut aufrufen.";
        }
      &Error($Message); # &Exit(1);
      } # Fehler beim Löschen

      if ( $O{'details'} > 3 ) { print("${ch}remove_tree$cr« $BakOutDirname\n"); }
    } # BackOutDirname existiert: Alles löschen

  if ( -e $OutDirname ) { 
    $Ergebnis = move($OutDirname,$BakOutDirname);
    $PerlErrorMessage = "$!";
    if ( $Ergebnis and ($O{'details'} > 3) ) { print("$OutDirname $ch→→→$cr $BakOutDirname\n"); }
    if ( not $Ergebnis ) {
      $Message = "»$cf$OutDirname$cr« vorgefunden, konnte nicht in »$cf$BakOutDirname$cr« umbenannt werden.";
      if ( $O{'details'} > 0 ) { $Message .= $cr;
        $Message .= "\n                   In »$cf$OutDirname sollen erstellte HTML usw. -Dateien abgelegt werden.";
        $Message .= "\n         Maßnahme: Mit Mitteln des Betriebssystems prüfen, warum die Umbenennung in »$cf$BakOutDirname$cr« gescheitert ist.";
        $Message .= "\n                   Eventuell vorhandene Dateien bzw. Verzeichnisse »$cr$OutDirname$cr« und »$cf$BakOutDirname$cr« löschen.";
        }
      if ( $O{'details'} > 2 ) { $Message .= "\n                       Perl-Error-Message: $PerlErrorMessage"; } 
      &Error($Message); # &Exit(1);
      }
    } # OutDirname existiert: Umbenennen

  $Ergebnis = mkdir($OutDirname);
  $PerlErrorMessage = "$!";
                #&Dprint("mkdir OutDirname: $OutDirname, Ergebnis: $Ergebnis, PerlErrorMessage: $PerlErrorMessage"); # exit 7;
