sub ReadUTF8File #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:   @Zeilen = &ReadUTF8File($Dateiname);
    # Liest den Inhalt der Datei $Dateiname und gibt diesen (ohne Newlines usw.) zurück
    # Falls etwas nicht funktioniert wie erwartet, werden entsprechende Meldungen ausgegeben.
  my($Dateiname) = @_;
  my($INUTF8);
  my(@Zeilen) = ();
  my($tt,$AbsDateiname);
  my($l) = 0;

  if ( not open($INUTF8,"<:utf8",$Dateiname) ) {
    $AbsDateiname = File::Spec->rel2abs($Dateiname,"");
    &Warn("Datei »$cf$AbsDateiname$cr« konnte nicht zum Lesen geöffnet werden");
    return @Zeilen;
    } # open failed

  while (<$INUTF8>) {
    chomp($_);
    $tt = $_;
    $l++;
    push(@Zeilen,$tt);
    } # while (<$INUTF8>)

  close($INUTF8);
  return @Zeilen;
  } # sub ReadUTF8File #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

