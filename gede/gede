sub AnalysiereTextZeile #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $Text = &AnalysiereTextZeile($Key,$z_Begriff);
    # Prüft, ob der $Key in %$z_Begriff existiert und eine Zeichenfolge enthält.
    # Wenn ja, wird diese zurückgegeben.
    # Sofern die Zeichenfolge gleich '-' ist oder nur Leerzeichen enthält, wird '&nbsp;' (genauer: $O{'LeereZelle'})
    # zurückgegeben.
    # Wenn nein, wird eine entsprechende Meldung ausgegeben und entweder terminiert oder mit
    # undef zurückgekehrt.
  my($Key,$z_Begriff) = @_;
  my($BegriffsId) = $S{'aktuelleBegriffsId'};
  my($Status,$Text);
  my($Message) = "$ScriptName: Internal error AnalysiereTextZeile Should never be printed";

  $Status = &PruefeKeyValue($Key,$z_Begriff);

  if ( not (defined($Status)) ) {
    $Message = "Begriffs-Id »$co$BegriffsId$cr«: Key »$Key« in den Daten des Begriffs nicht gefunden.";
    $Message .= "\n                   Wahrscheinlich ein Programmierfehler in $ScriptName,";
    $Message .= "\n                   erkannt in Subroutine AnalysiereTextZeile.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # Status undefined

  if ( $Status ne "" ) { # $ Status = ref(...)!
    $Message = "Begriffs-Id »$co$BegriffsId$cr«: Zum Key »$Key« steht in den Daten des Begriffs keine Zeichenfolge,";
    $Message .= "\n                   stattdessen ein $Status.";
    $Message .= "\n                   Wahrscheinlich ein Programmierfehler in $ScriptName, erkannt in Subroutine";
    $Message .= "\n                   AnalysiereTextZeile. Begriff ${cw}nicht übernommen$cr.";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return undef;
    }

  $Text = $$z_Begriff{$Key};
                #&Dprint("AnalysiereTextZeile($BegriffsId): »$Key«, »$Status«, »$Text«");
  if ( $Text =~ /^\s*$/ ) {
    $Message = "Begriffs-Id »$co$BegriffsId$cr«: Zum Key »$Key« in den Daten des Begriffs nur Leerzeichen gefunden.";
    $Message .= "\n                   Wahrscheinlich ein Programmierfehler in $ScriptName, erkannt in Subroutine";
    $Message .= "\n                   AnalysiereTextZeile. Begriff ${cw}nicht übernommen$cr.";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return undef;
    }

  $Text = $O{'LeereZelle'} if ( $Text =~ /^\s*-\s*$/ );
  return $Text;
  } # sub AnalysiereTextZeile #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

