  if ( not $Ergebnis ) {
    $Message = "Verzeichnis »$cf$OutDirname$cr« konnte nicht angelegt werden.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                     In »$cf$OutDirname$cr« sollen die erstellten web2.0 HTML- usw. Dateien gespeichert werden.";
      $Message .= "\n           Maßnahme: Mit Mitteln des Betriebssystems prüfen, warum das Anlagen des Verzeinisses »$cf$OutDirname$cr« gescheitert ist.";
      $Message .= "\n                     Eventuell Schreib- und Leserechte prüfen sowie eventuell vorhandene Dateien bzw. Verzeichnisse »$cf$OutDirname$cr«.";
      }
    if ( $O{'details'} > 2 ) { $Message .= "\n                       Perl-Error-Message: $PerlErrorMessage"; } 
