sub BegriffstabellenZuHash #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &BegriffstabellenZuHash();
    # Analysiert die als Tabellen in der globalen Variablen @BegriffeAlsTabellen abgelegten 
    # Begriffsdaten und wandelt diese in den Begriffs-Id-basierten Hash %BegriffeByBegriffsId um.
    # Dabei werden einige inhaltliche und formale Prüfungen gemacht.
    # Falls etwas nicht funktioniert wie erwartet, werden entsprechende Meldungen ausgegeben.
  my($TabellenZahl,$Message,$z_Tabelle,$Status);

  $TabellenZahl = scalar(@BegriffeAlsTabellen);
  if ( $TabellenZahl < 1 ) {
    $Message = "Keine Begriffe in BegriffeAlsTabellen gefunden. Ausführung beendet.";
    if ( $O{'details'} > 0 ) {
      $Message .= $cr;
      $Message  = "\n      Erläuterung: In der globalen Variablen BegriffeAlsTabellen werden die aus den Pandoc-";
      $Message .= "\n                   HTMLs in Tabellenform zwischengespeichert.";
      $Message .= "\nMögliche Ursachen: 1. $ScriptName wurde in einem Verzeichnis aufgerufen, unter dem es keine";
      $Message .= "\n                   verarbeitbaren .docx-Dateien gibt.";
      $Message .= "\n                   2. Programmierfehler im Skript.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: $ScriptName in einem Verzeichnis aufrufen, in dem es umwandelbare Dateien gibt.";
      $Message .= "\n                   Programmierfehler analysieren und beseitigen.";
      }
    &Error($Message); # &Exit(1);
    } # TabellenZahl < 1

  foreach $z_Tabelle (@BegriffeAlsTabellen) { # Alle Begriffe, $z_Tabelle zeigt auf den jeweiligen Begriff
    $Status = &TabelleZuHash($z_Tabelle);
    if ( $Status ) { $S{'hashBegriffe'} += 1; }
    else { $S{'nichthash'} += 1; }
    } # foreach @BegriffeAlsTabellen
  return;
  } # sub BegriffstabellenZuHash #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub TabelleZuHash #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $Status = TabelleZuHash($z_Tabelle);
    # Wandelt die Begriffs-Tabelle auf die $z_Tabelle zeigt in das interne Hash-Format um.
    # Dabei wird Inhalt und Format teilweise geprüft.
    # Wenn die Umwandlung durchgeführt wurde, wird TRUE zurückgegeben, ansonsten FALSE
    # Falls etwas nicht funktioniert wie erwartet, werden entsprechende Meldungen ausgegeben.
  my($z_Tabelle) = @_;
  my($Status) = FALSE;
  my($Message,$Zeilenzahl,$StatusZeile,$Grund,$t,$l,$Zeilennummer);
  my(@Tabelle,$z_Zeile,$Zelle1,$z_Zelle2,$Zelle2,@OhneTags,@FehlendeDaten,@LeereDaten);
  my($AbsDateiname,$Basename,$BegriffsId,$Key,$Wert,$Typ);
  my(%BegriffsHash) = %BegriffsHashTemplate;

  @Tabelle = @$z_Tabelle;
  $Zeilenzahl = scalar(@Tabelle);
  
  $z_Zeile = shift(@Tabelle); # Soll Dateinamen sein
  if ( ($Zeilenzahl < 1) or (not defined($z_Zeile)) ) {
    $Message = "Begriff ohne Inhalt in BegriffeAlsTabellen gefunden, übersprungen.";
    &Warn($Message);
    return FALSE;
    } # Zeilenzahl < 1

  $Zeilennummer = 1;
  ($StatusZeile,$Grund,$Zelle1,$z_Zelle2) = &PruefeUndExtrahiereZeile($z_Zeile);

  if ( not $StatusZeile ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Dateinamen des Begriffs enthalten.";
    $Message .= "\n                   Diese Zeile wurde nicht gefunden: Programmierfehler in $ScriptName.";
    $Message .= "\n                   Ausführung beendet.";
    $Message .= &AddMPF(1);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n            Grund: $Grund.";
      }
    &Error($Message); # &Exit(1);
    } # not StatusZeile (für Dateinamen-Zeile)

  if ( $Zelle1 ne "Dateiname" ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Dateinamen des Begriffs enthalten. Dazu muss im ersten Feld";
    $Message .= "\n                   die Zeichenfolge »${co}Dateiname$cr« stehen. Dort steht »$co$Zelle1$cr«:";
    $Message .= "\n                   Programmierfehler in $ScriptName. Ausführung beendet.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # 1. Zeile ist keine Dateinamen-Zeile

  if ( scalar(@$z_Zelle2) < 1 ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Dateinamen des Begriffs enthalten. Dazu muss im zweitem Feld";
    $Message .= "\n                   der (absolute) Dateiname stehen. Dieses ist aber leer:";
    $Message .= "\n                   Programmierfehler in $ScriptName. Ausführung beendet.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # Dateinamenfeld: Keine Elemente

  $AbsDateiname = join(" ",@$z_Zelle2);
  if ( scalar(@$z_Zelle2) > 1 ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Dateinamen des Begriffs enthalten. Dazu muss im zweitem Feld";
    $Message .= "\n                   genau der (absolute) Dateiname stehen. Dort stehen aber mehr Daten:";
    $Message .= "\n                   $cf$AbsDateiname$cr";
    $Message .= "\n                   Programmierfehler in $ScriptName. Ausführung beendet.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # Dateinamenfeld: zu viele Inhalte

  if ( $AbsDateiname =~ /^\s*$/ ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Dateinamen des Begriffs enthalten. Dazu muss im zweitem Feld";
    $Message .= "\n                   der (absolute) Dateiname stehen. Dieses enthält aber nur White-Space:";
    $Message .= "\n                   Programmierfehler in $ScriptName. Ausführung beendet.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # Dateinamenfeld: Nur White-Space

  $BegriffsHash{"Dateiname"} = $AbsDateiname;
  $l = scalar(@$z_Tabelle);
  if ( $O{'details'} > 2 ) { print("    $cf$AbsDateiname$cr → $l interne Zeilen\n"); }
  if ( $O{'details'} > 3 ) { print("        Zeile $Zeilennummer: »$Zelle1« | »$AbsDateiname«\n"); }

  $Zeilenzahl = scalar(@Tabelle);
  $z_Zeile = shift(@Tabelle); # Soll Basename sein

  if ( ($Zeilenzahl < 1) or (not defined($z_Zeile)) ) {
    $Message = "Begriff mit zu wenig Inhalten (Basename) in BegriffeAlsTabellen gefunden, übersprungen.";
    $Message .= "\n                   Die zweite Zeile eines Begriffs in der internen Ablage muss den";
    $Message .= "\n                   Basename (d. h. Dateiname ohne Extension) des Begriffs enthalten.";
    $Message .= "\n                   Diese Zeile wurde in $cf$AbsDateiname$cr nicht gefunden:";
    $Message .= "\n                   Programmierfehler in $ScriptName.";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return FALSE;
    } # Zweite Zeile (Basename) nicht vorhanden

  $Zeilennummer++;
  ($StatusZeile,$Grund,$Zelle1,$z_Zelle2) = &PruefeUndExtrahiereZeile($z_Zeile);

  if ( not $StatusZeile ) {
    $Message = "Die zweite Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Basename des Begriffs enthalten, d. h. den Dateinamen ohne Extension.";
    $Message .= "\n                   Diese Zeile wurde in $cf$AbsDateiname$cr nicht gefunden:";
    $Message .= "\n                   Programmierfehler in $ScriptName. Begriff ${cw}übersprungen$cr";
    $Message .= &AddMPF(1);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n            Grund: $Grund.";
      }
    &Warn($Message);
    return FALSE;
    } # not StatusZeile (für Basename-Zeile)

  if ( $Zelle1 ne "Basename" ) {
    $Message = "Die zweite Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Basename des Begriffs enthalten. Dazu muss im ersten Feld";
    $Message .= "\n                   die Zeichenfolge »Basename« stehen.";
    $Message .= "\n                   Im Begriff $cf$AbsDateiname$cr steht dort »$co$Zelle1$cr«.";
    $Message .= "\n                   Programmierfehler in $ScriptName. Begriff ${cw}übersprungen$cr";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return FALSE;
    } # 2. Zeile ist keine Basename-Zeile

  if ( scalar(@$z_Zelle2) < 1 ) {
    $Message = "Die erste Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Basename des Begriffs enthalten. Dazu muss im zweitem Feld";
    $Message .= "\n                   genau der Basename stehen.";
    $Message .= "\n                   Dieses enthält im Begriff $cf$AbsDateiname$cr aber keine Daten.";
    $Message .= "\n                   Programmierfehler in $ScriptName. Begriff ${cw}übersprungen$cr";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return FALSE;
    } # Basename-Feld: Keine Elemente

  $Basename = join(" ",@$z_Zelle2);
  if ( scalar(@$z_Zelle2) > 1 ) {
    $Message = "Die zweite Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Basename des Begriffs enthalten. Dazu muss im zweiten Feld";
    $Message .= "\n                   genau der Basename stehen.";
    $Message .= "\n                   Im Begriff $cf$AbsDateiname$cr stehen dort aber mehr Daten:";
    $Message .= "\n                   »$co$Basename$cr«";
    $Message .= "\n                   Programmierfehler in $ScriptName. Begriff ${cw}übersprungen$cr";
    $Message .= &AddMPF(1);
    &Warn($Message);
    return FALSE;
    } # Basename-Feld: Zu viele Inhalte
  if ( $Basename =~ /^\s*$/ ) {
    $Message = "Die zweite Zeile eines Begriffs in der internen Ablage BegriffeAlsTabellen muss den";
    $Message .= "\n                   Basename des Begriffs enthalten. Dazu muss im zweiten Feld";
    $Message .= "\n                   genau der Basename stehen. Dieses enthält aber nur White-Space:";
    $Message .= "\n                   Im Begriff $cf$AbsDateiname$cr steht dort aber nur White-Space:";
    $Message .= "\n                   »$co$Basename$cr«";
    $Message .= "\n                   Programmierfehler in $ScriptName. Begriff ${cw}übersprungen$cr";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # Dateinamenfeld: Nur White-Space

  if ( $Basename !~ $O{'guteZeichen'} ) {
    &Warn("Unerwünschte Zeichen im Basename »$cf$Basename$cr« des Begriffs $cf$AbsDateiname$cr");
    } # Unerwünschte Zeichen im Basename
  $BegriffsHash{"Basename"} = $Basename;
  if ( $O{'details'} > 3 ) { print("        Zeile $Zeilennummer: »$Zelle1« | »$Basename«\n"); }

  foreach $z_Zeile (@Tabelle) {
    $Zeilennummer++;
    ($StatusZeile,$Grund,$Zelle1,$z_Zelle2) = &PruefeUndExtrahiereZeile($z_Zeile);

    if ( not $StatusZeile ) {
      if ( $O{'details'} > 3 ) {
        $Message = "        Zeile $Zeilennummer: Keine Daten übernommen. Grund: $Grund\n"; 
        $Message .= "\n        Pfadname: $cf$AbsDateiname$cr";
        print($Message,"\n");
        }
      next;
      } # not $StatusZeile: Zeile wird weder ausgewertet noch werden Daten übernommen

    if ( not exists($BegriffsHash{$Zelle1}) ) {
      $Message = "Unbekannter Zeilenkopf »$co$Zelle1$cr«";
      &Warn($Message . ", Inhalte nicht übernommen aus\n         $cf$AbsDateiname$cr");
      if ( $O{'details'} > 3 ) { print("        Zeile $Zeilennummer: Keine Daten übernommen. Grund: $Message\n"); }
      next;
      } # if not exists BegriffsHash{Zelle1}: Unbekannter Zeilenkopf
    # Bekannter Zeilenkopf in Zelle1: In

    if ( exists($ZeilenMitTagHash{$Zelle1}) ) {
      $BegriffsHash{$Zelle1} = $z_Zelle2;
      if ( $O{'details'} > 3 ) {
        $Message = "        Zeile $Zeilennummer: »$Zelle1« | »@$z_Zelle2«"; 
        $Message .= "\n        Pfadname: $cf$AbsDateiname$cr";
        print($Message,"\n");
        }
      next;
      } # Zeile mit Tags
    #
    # Wert der Zeile darf keine Tags enthalten
    @OhneTags = &EntferneTags(@$z_Zelle2);
    $Zelle2 = join(" ",@OhneTags);
    $BegriffsHash{$Zelle1} = $Zelle2;
      if ( $O{'details'} > 3 ) {
        $Message = "        Zeile $Zeilennummer: »$Zelle1« | »@$z_Zelle2«"; 
        $Message .= "\n        Pfadname: $cf$AbsDateiname$cr";
        print($Message,"\n");
        }
    } # foreach @Tabelle

  $Status = TRUE;
  @FehlendeDaten = ();
  @LeereDaten = ();
  foreach $Key (sort(@Zeilenkopf)) {
    if ( not exists($BegriffsHash{$Key}) ) {
      $Status = FALSE;
      $Message = "Datei $cf$AbsDateiname$cr:";
      $Message .= "\n                   Zeilenkopf $co$Key$cr existiert nicht in der internen Datenstruktur";
      $Message .= "\n                   BegriffsHash: Programmierfehler in $ScriptName.";
      $Message .= "\n                   Ausführung beendet.";
      $Message .= &AddMPF(1);
      &Error($Message); # &Exit(1);
      } # Key existiert nicht

    # $Key existiert in %BegriffsHash, es kann aber sein, dass der Wert undefiniert ist
    if ( not defined($BegriffsHash{$Key}) ) {
      push(@FehlendeDaten,$Key);
      next;
      } # Keine Daten in Zeile $Key

    # $Key existiert in %BegriffsHash, Wert ist definiert, dieser kann aber leer sein
    $Wert = $BegriffsHash{$Key};
    $Typ = ref($Wert);
    if ( $Typ eq "" ) { push(@LeereDaten,$Key) if ( $Wert =~ /^\s*$/ ); } # Skalar
    elsif ( $Typ eq "ARRAY" ) { push(@LeereDaten,$Key) if ( scalar(@$Wert) < 1 ); } # Array
    else  { # Unerwarteter Datentyp
      $Message = "Datei $cf$AbsDateiname$cr:";
      $Message .= "\n                   Zeile $co$Key$cr hat in der internen Datenstruktur BegriffsHash den nicht";
      $Message .= "\n                   erwarteten Datentyp $cr$Typ$cr: Programmierfehler in $ScriptName.";
      $Message .= "\n                   Ausführung beendet.";
      $Message .= &AddMPF(1);
      &Error($Message); # &Exit(1);
      } # Unerwarteter Datentyp
    } # foreach @Zeilenkopf

  foreach $Key (@FehlendeDaten) {
  if ( exists($DatenErforderlichHash{$Key}) ) {
    $Status = FALSE;
    $Message = "Datei $cf$AbsDateiname$cr:";
    $Message .= "\n         Keine Daten in Zeile $co$Key$cr. Begriff ${cw}nicht übernommen$cr.";
    $Message .= "\n         Z. B. Bindestrich (-) einfügen.";
    &Warn($Message);
    return FALSE;
    } # Fehlende erforderliche Daten
  } # foreach FehlendeDaten

  foreach $Key (@LeereDaten) {
    if ( exists($DatenErforderlichHash{$Key}) ) {
      $Message = "Datei $cf$AbsDateiname$cr:";
      $Message .= "\n         Keine Daten in Zeile $co$Key$cr. Begriff ${cw}nicht übernommen$cr.";
      $Message .= "\n         Z. B. Bindestrich (-) einfügen.";
      &Warn($Message);
      return FALSE;
      } # Fehlende erforderliche Daten
    next if ( exists($LeereDatenOKHash{$Key}) ); # Leere Daten sind ok
    # Programmierfehler
    $Message = "Datei $cf$AbsDateiname$cr:";
    $Message .= "\n                   Zeile »$co$Key$cr« muss Daten enthalten: Programmierfehler in $ScriptName.";
    $Message .= "\n                   Ausführung beendet.";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
  } # foreach LeereDaten
  
  $BegriffsId = $BegriffsHash{'Begriffs-Id'};

  if ( exists($BegriffeByBegriffsId{$BegriffsId}) ) {
    $Status = FALSE;
    $Message = "Datei $cf$AbsDateiname$cr:";
    $Message .= "\n         Begriffs-Id »$BegriffsId« bereits vorhanden in Datei";
    $Message .= "\n         ${$BegriffeByBegriffsId{$BegriffsId}}{'Dateiname'}";
    $Message .= "\n         Aktuellen Begriff ${cw}nicht übernommen$cr.";
    if ( $O{'details'} > 1 ) {
      $Message .= "\n        Maßnahme: Begriffs-Id in Google-Docs korrigieren.";
      }
    &Warn($Message);
    return FALSE;
    } # BegriffsId ne Basename

  if ( $BegriffsId ne $Basename ) {
    $Status = FALSE;
    $Message = "Datei $cf$AbsDateiname$cr:";
    $Message .= "\n         Begriffs-Id »$BegriffsId« unterscheidet sich vom Google-Docs-Dateiname ($cf$Basename$cr).";
    $Message .= "\n         Begriff ${cw}nicht übernommen$cr.";
    if ( $O{'details'} > 1 ) {
      $Message .= "\n        Maßnahme: Begriffs-Id bzw. Dateinamen in Google-Docs korrigieren.";
      }
    &Warn($Message);
    return FALSE;
    } # BegriffsId ne Basename

  $BegriffeByBegriffsId{$BegriffsId} = \%BegriffsHash if ( $Status );
  return $Status;
  } # Sub TabelleZuHash

sub PruefeUndExtrahiereZeile #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  ($Status,$Grund,$Element0,$z_Element1) = PruefeUndExtrahiereZeile($z_Zeile);
    # Prüft, ob in $z_Zeile eine Referenz auf eine Zeile enthalten ist, die Werte enthält, die für
    # die Erstellung der Webseiten bzw. die weitere Verarbeitung wichtig sind.
    # In $Grund wird das jeweilige Ergebnis der Prüfung zurückgegeben.
    # Geprüft wird:
    # - $z_Zeile ist eine Referenz auf einen anonymen Array
    # - Der anonyme Array hat genau 2 Elemente 
    # - Beide Elemente sind anonyme, nichtleere Arrays
    # - Wenn Element 0 Tags enthält werden diese entfernt
    # - Element 0 ist nicht leer
    # Wenn alle Prüfungen bestanden werden, wird TRUE sowie ein sinnvoller Wert für die beiden Elemente 
    # zurückgegeben, sonst FALSE und passende Werte.
    # Wenn Element 1 leer ist, wird der Grund "Element 1 leer" und "" (via "@$z_Element1") zurückgegeben.
  my($z_Zeile) = @_;
  my($l,$t,$t0,@Zeile,$z_Element0,$z_Element1,@Element0);
  my($Element0) = "nicht aus eingelesenen Daten gesetzt";

  $t = ref($z_Zeile);
  return (FALSE,"kein anonymer Array",undef,undef) if ( $t ne "ARRAY" );
  @Zeile = @$z_Zeile; # Dereferenzierung: Übersichtlichere Handhabung, erhält Original
  $l = scalar(@Zeile);
  return (FALSE,"keine 2 Elemente",undef,undef) if ( $l != 2 );

  $z_Element0 = shift(@Zeile);
  return (FALSE,"Element 0 undefiniert",undef,undef) if ( not defined($z_Element0) );
  $t = ref($z_Element0);
  return (FALSE,"Element 0 kein anonymer Array",$z_Element0,undef) if ( $t ne "ARRAY" );
  @Element0 = @$z_Element0; # Dereferenzierung: Übersichtlichere Handhabung, erhält Original
  @Element0 = &EntferneTags(@Element0);
                #print($cd,"P&E: Element0\n",Dumper(@Element0),$cr,"\n");
  $l = scalar(@Element0);
  $Element0 = join(" ",@Element0);

  $z_Element1 = shift(@Zeile);
  return (FALSE,"Element 1 undefiniert",$Element0,undef) if ( not defined($z_Element1) );

  return (FALSE,"Element 0 leer",$Element0,$z_Element1) if ( $l < 1 );

  $t = ref($z_Element1);
  return (FALSE,"Element 1 kein anonymer Array",$Element0,$z_Element1) if ( $t ne "ARRAY" );

  $l = scalar(@$z_Element1);
  return (TRUE,"Element 1 leer",$Element0,$z_Element1) if ( $l < 1 );

  return (TRUE,"ok",$Element0,$z_Element1);
  } # sub PruefeUndExtrahiereZeile #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

