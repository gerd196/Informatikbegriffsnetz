sub AnalysiereFreigaben #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  ($Status,$Freigabedatum) = &AnalysiereFreigaben($Freigaben);
    # Prüft und $Freigabedaten und gibt letztes Freigabedatum zurück.
    # Falls kein Freigabedatum gefunden wird, wird $O{'StandardFreigabeDatum'} zurückgegeben.
    # Wenn etwas nicht so ist wie es sein soll, wird FALSE zurückgegeben und eine entsprechende Meldung
    # ausgegeben, ansonsten TRUE.
    # Befüllt %SynonymeZuBegriffsIds
  my($Freigaben) = @_;
  my(@FGDList) = ();
  my($Message) = "$ScriptName: Internal error AnalysiereFreigaben Should never be printed";
  my($Freigabedatum) = $O{'StandardFreigabeDatum'};
  my($tt,$Fl,$Fd,$Status);

  if ( $Freigaben eq $O{'LeereZelle'} ) {
    $Message = "Begriffs-Id $co$S{'aktuelleBegriffsId'}$cr (Datei $cf$S{'aktuellerDateiname'}$cr):";
    $Message .= "\n         Kein Freigabedatum gefunden, Standardwert $O{'StandardFreigabeDatum'} gesetzt.";
    $Message .= &AddM2;
    &Warn($Message);
    return (TRUE,$Freigabedatum);
    }
  
  @FGDList = split(/\s*,\s*/,$Freigaben);
  $Fl = scalar(@FGDList);

  return (TRUE,$Freigabedatum) if ( $Fl < 1 );
  $Fd = pop(@FGDList);
                #&Dprint("\nAnalysiereFreigaben: »$Freigaben« → »$Fd«");
  if ( $Fd !~ /^[12][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9]$/ ) {
    $Message = "Begriffs-Id $co$S{'aktuelleBegriffsId'}$cr (Datei $cf$S{'aktuellerDateiname'}$cr):";
    $Message .= "\n         Freigabedatum »$co$Fd$cr« nicht im Format ${co}YYYY-MM-DD$cr, Standardwert $O{'StandardFreigabeDatum'} verwendet.";
    $Message .= &AddM2;
    &Warn($Message);
    return (TRUE,$Freigabedatum);
    } # Falsches Format

  $Freigabedatum = $Fd;
  return (TRUE,$Freigabedatum);
  } # sub AnalysiereFreigaben #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

