sub TokenizePandocHTML #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $z_Token = &TokenizePandocHTML($AbsDateiname,$z_PandocHTML);
    # Tokenisiert das Pandoc-HTML-Fragment $z_PandocHTML und gibt, sofern es zu keinem Fehler
    # kam, eine Referenz auf die Token-Liste zurück
    # Zwei Token-Arten:
    #  - Content
    #  - Tag
    # Ein Tag-Token ist nicht leer und beginnt und endet mit < bzw. >.
    # Ein Content-Token ist nicht leer, beginnt mit einem Zeichen ungleich <
    # Eventuell vorgefundene HTML-Kommentare (<!--   -->) werden nicht übernommen.
    # Verwendete Status zur Tokenisierung sind:
    #   0 (in Content-Token)
    #   1 (in Tag-Token)
    #   2 (in Tag-Token und in Single-Apostrophen ('))
    #   3 (in Tag-Token und in DoppelApostrophen ("))
    #   4 (in HTML-Kommentar
    # Im Fehlerfall wird eine Warnung erstellt.
  my($AbsDateiname,$z_PandocHTML) = @_;
  use constant {
               INCONTENT => 0,
               INTAG => 1,
               INQUOTE => 2, # Gibt es nur in Tags!
               INAPOSTROPH => 3, # Gibt es nur in Tags!
               INCOMMENT => 4,
               };
  my(@Chars) = ();
  my(@Token) = ();
  my($CurrentToken) = "";
  my($c,$c1,$c2,$c3,$Status);

  @Chars = split(//,join(" ",@$z_PandocHTML));
  $Status = INCONTENT;
  while (@Chars) {
    $c = shift(@Chars);

    if ( $Status == INCOMMENT ) { # In HTML-Kommentar
      next unless ( $c eq "-" ); # Definitiv kein Ende eines HTML-Kommentars
      $c1 = shift(@Chars);
      last if ( not defined($c1) ); # Ende von @Chars
      $c2 = shift(@Chars);
      last if ( not defined($c2) ); # Ende von @Chars
      if ( ($c eq "-") and ($c1 eq "-") and ($c2 eq ">") ) { 
        $Status = INCONTENT;
        $CurrentToken = "";
        } # Formales Ende eines HTML-Kommentars
      next;
      } # HTML-Kommentar

    if ( $Status == INQUOTE ) { # Quote-Text (')
      $CurrentToken .= $c;
      if ( $c eq "'" ) { $Status = INTAG; } # Ende-Quote
      next;
      } # Quote-Text (')

    if ( $Status == INAPOSTROPH ) { # Text in Apostrophen (")
      $CurrentToken .= $c;
      if ( $c eq '"' ) { $Status = INTAG; } # Ende-Apostroph
      } # Text in Apostrophen (")

    if ( $Status == INTAG ) { # In HTML-Tag
      $CurrentToken .= $c;
      if ( $c eq ">" ) { # Ende HTML-Tag
        $Status = INCONTENT;
        push(@Token,$CurrentToken);
        $CurrentToken = "";
        } # Ende HTML-Tag
      next;
      } # In HTML-Tag

    if ( $Status == INCONTENT ) { # In HTML-Content
      if ( $c eq "<" ) { # Tag- oder Kommentarbeginn
        # if ( $CurrentToken =~/^ +$/ ) { &Warn("$AbsDateiname: HTML-Inhalt nur aus Leerzeichen."); } 
        if ( $CurrentToken !~ /^ *$/ ) { push(@Token,$CurrentToken); } # Kein Content-Token nur aus Leerzeichen: speichern
        $Status = INTAG;
        $CurrentToken = $c;
        if ( scalar(@Chars) < 1 ) {
          &Warn("$cf$AbsDateiname$cr: Letztes Zeichen des HTML-Inhalts ist ein '<'.");
          $CurrentToken .= $c;
          last; # Alles tokenisiert
          } # Kein weiteres Zeichen in @Chars (und damit im Tag) vorhanden
        # Prüfe auf Bewginn eines HTML-Kommentars (<!--)
        $c1 = $Chars[0];
        if ( ($c1 eq "!") and (scalar(@Chars) > 3) ) { # Evtl. HTML-Kommentar
          $c2 = $Chars[1];
          $c3 = $Chars[2];
          if ( ($c2 eq "-") and ($c3 eq "-") ) { # Beginn HTML-Kommentar!
            $Status = INCOMMENT;
            $CurrentToken = "";
            shift(@Chars); shift(@Chars); shift(@Chars); 
            next;
            } # Beginn HTML-Kommentar!
          } # Evtl. HTML-Kommentar
        # Kein Kommentar, normler Tag-Beginn, bereits alles getan
        next;
        } # Tag- oder Kommentarbeginn
      # Weiter gehts mit HTML-Content
      $CurrentToken .= $c;
      next;
      } # In HTML-Content
    &Error("$ScriptName, TokenizePandocHTML: Programmierfehler Unbekannter Status.");
    } # while (@Chars)

  if ( $CurrentToken ne '' ) { push(@Token,$CurrentToken); }
  return \@Token;
  } # sub TokenizePandocHTML #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub TokenZuTabelle #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $z_Tabelle = TokenZuTabelle($AbsDateiname,$z_Token);
    # Eingabe: @$z_Token: Tokenisiertes HTML einer .docx-Informatikbegriffsnetz-Datei.
    # Teilt die Token @$z_Token an <tr>- (und falls vorhanden <\tr>- )Token auf.
    # Befüllt @Tabelle zuerst mit den Zellinhalten für Dateiname und Basename
    # Erstellt dann die separierten Token zwischen <tr>-Token als Liste.
    # Token außerhalb von <tr>-Token werden ignoriert.
    # Anschließend werden die Zeilen weiter in das zellen-basierte Tabellenformat umgewandelt und
    # an @Tabelle angehängt.
    # Falls irgendetwas nicht so ist, wie es sein soll, wird eine geeignete Meldung ausgegeben 
  my($AbsDateiname,$z_Token) = @_;
  my(@Tabelle) = ();
  my(@Zeilen_Token) = ();
  my($z_TabellenZeile,$b,$l);

  # Tabelle mit absolutem Dateinamen befüllen
  $z_TabellenZeile = [];
  push(@$z_TabellenZeile,["Dateiname"]);
  push(@$z_TabellenZeile,[$AbsDateiname]);
  push(@Tabelle,$z_TabellenZeile);
  # Tabelle mit Basisname befüllen
  $z_TabellenZeile = [];
  push(@$z_TabellenZeile,["Basename"]);
  $b = $AbsDateinameToBasename{$AbsDateiname};
  push(@$z_TabellenZeile,[$b]);
  push(@Tabelle,$z_TabellenZeile);

  @Zeilen_Token = &TokenZuZeilen($z_Token);
  $l = scalar(@Zeilen_Token);
  if ( $O{'details'} > 1 ) { print("    $l Tabellenzeilen in $cf$AbsDateiname$cr\n"); } 
                #&DumpArrayArray(\@Zeilen_Token,"\nZeilen_Token"); # exit 7;
  foreach $z_Token (@Zeilen_Token) {
    $z_TabellenZeile = &TokenZuZellen($z_Token);
    push(@Tabelle,$z_TabellenZeile);
    } # foreach @Zeichen_Token

  return \@Tabelle;
  } # sub TokenZuTabelle #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub TokenZuZeilen #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  @Zeilen = &TokenZuZeilen($z_Token);
    # Eingabe: @$z_Token: Tokenisiertes HTML einer .docx-Begriffsdatei.
    # Teilt die Token @$z_Token an <tr>- (und falls vorhanden <\tr>- )Token auf.
    # Erstellt dann die separierten Token zwischen <tr>-Token als Liste.
    # Token außerhalb von <tr>-Token werden ignoriert.
    # Gibt die aufgeteilten Zeilen (als Token-Liste) als Array zurück.
    # Falls irgendetwas nicht so ist, wie es sein soll, wird eine geeignete Meldung ausgegeben 
  my($z_Token) = @_;
  my(@Zeilen) = ();
  my($z_AktuelleZeile) = [];
  my($Token,$l);
  my($InZeile) = FALSE;

  foreach $Token (@$z_Token) {
    if ( $InZeile ) {
      if ( $Token eq "</tr>" ) {
        $InZeile = FALSE;
        push(@Zeilen, $z_AktuelleZeile) if ( scalar(@$z_AktuelleZeile) > 0 );
        $z_AktuelleZeile = [];
        next;
        }
      if ( $Token eq "<tr>" ) {
        $InZeile = TRUE;
        push(@Zeilen, $z_AktuelleZeile) if ( scalar(@$z_AktuelleZeile) > 0 );
        $z_AktuelleZeile = [];
        next;
        }
      push(@$z_AktuelleZeile, $Token) if ( $Token ne "" );
      next;
      } # In Zeile, d. h. nach <tr> und vor </tr> bzw. nächstem <tr>
    # Nicht in Zeile
    if ( $Token eq "<tr>") { $InZeile = TRUE; }
    } # foreach @$z_Token

  return @Zeilen;
  } # sub TokenZuZeilen #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub TokenZuZellen #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  $z_Zellen_Token = &TokenZuZellen($z_Token);
    # Teilt die Token @$z_Token an <th>- bzw- <td>- (und falls vorhanden </th>- bzw. </td> )Token auf.
    # Liefert jeweils die Token zwischen <th|d>-Token als Liste zurück.
    # Token außerhalb von <th|d>-Token werden ignoriert.
    # Falls irgendetwas nicht so ist, wie es sein soll, wird eine geeignete Meldung ausgegeben 
  my($z_Token) = @_;
  my(@Zellen) = ();
  my($z_AktuelleZelle) = [];
  my($Token,$l,$t);
  my($InZelle) = FALSE;

                #&Dprint("\nTokenZuZellen"); # exit 7;
                #$t = join("« »",@$z_Token);
                #$l = scalar(@$z_Token);
                #&Dprint("$l Token: »$t«"); # exit 7;
  foreach $Token (@$z_Token) {
    if ( $InZelle ) {
      if ( ($Token eq "</th>") or ($Token eq "</td>") ) {
        $InZelle = FALSE;
        push(@Zellen, $z_AktuelleZelle);
        #push(@Zellen, $z_AktuelleZelle) if ( scalar(@$z_AktuelleZelle) > 0 );
        $z_AktuelleZelle = [];
        next;
        }
      if ( ($Token eq "<th>") or ($Token eq "<td>") or ($Token =~ /^<th /) or ($Token =~ /^<td /) ) {
        $InZelle = TRUE;
        push(@Zellen, $z_AktuelleZelle);
        #push(@Zellen, $z_AktuelleZelle) if ( scalar(@$z_AktuelleZelle) > 0 );
        $z_AktuelleZelle = [];
        next;
        }
      push(@$z_AktuelleZelle, $Token) if ( $Token ne "" );
      next;
      } # In Zelle, d. h. nach <th|d> und vor </th|d> bzw. nächstem <th|d>
    # Nicht in Zelle
    if ( ($Token eq "<th>") or ($Token eq "<td>") or ($Token =~ /^<th /) or ($Token =~ /^<td /) ) { $InZelle = TRUE; }
    } # foreach @$z_Token
                #$t = join("« »",@Zellen);
                #$l = scalar(@Zellen);
                #&Dprint("$l Zellen »$t«"); # exit 7;
                #print(Dumper(@Zellen));
  return \@Zellen;
  } # sub TokenZuZellen #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

sub TagStatistik #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &Tagstatistik($z_Token);
    # Fügt die Tags in $z_Tag zur den Tagstatistiken l und k dazu
  my($z_Tag) = @_;
  my($t,$tlang,$tkurz);

  foreach $t (@$z_Tag) {
    next if ( $t !~ /^</ );
    $t =~ /^<(.+)>$/;
    $tlang = $1;
    if ( exists($TagStatistikl{$tlang}) ) { $TagStatistikl{$tlang} += 1;  }
    else { $TagStatistikl{$tlang} = 1;  }
    next if ( $t =~ /^<\// );
    $tkurz = $tlang;
    if ( $t =~ / / ) {
      $t =~ /^<([^ ]*) /;
      $tkurz = $1;
      }
    if ( exists($TagStatistikk{$tkurz}) ) { $TagStatistikk{$tkurz} += 1;  }
    else { $TagStatistikk{$tkurz} = 1;  }
    }

  return;
  } # sub TagStatistik #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

