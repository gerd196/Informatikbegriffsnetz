    if ( $Status ) { $Message = "ok ($l Zeilen)"; }
    if ( $O{'details'} > 3 ) { print("    $ch-H →→→$cr $HTMLname: $Message\n"); }
    }

  if ( $O{'details'} > 0 ) { print("    $cf$AbsDateiname$cr → $l HTML-Zeilen\n"); } 
  return;
  } # sub ProcessPandocHTML #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

