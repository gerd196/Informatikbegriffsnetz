sub PruefePandocAufruf #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &PruefePandocAufruf();
    # Wenn Pandoc installiert ist und aufgerufen werden kann, wird $S{'PandocVersion'} 
    # auf die installierte Version gesetzt.
    # Falls Pandoc nicht aufgerufen werden kann, werden Fehlermeldungen ausgegeben und das
    # Skript beendet.
  my(@Ergebnis,$PandocExitCode,$t,$Firstline,$PandocVersion,$PandocVersionsrest);
  my($Hauptversion,$Unterversion,$TestHauptversion,$TestUnterversion);
  my($Message) = "$ScriptName: Internal error PruefePandocAufruf: Should never be printed";
  my($PandocCall) = "pandoc --version 2>&1";

  @Ergebnis = qx/$PandocCall/;
  $PandocExitCode = $?;
                #&Dprint("Ergebnis: $Ergebnis, PerlErrorMessage: $PerlErrorMessage"); # exit 7;
                #&DumpArray(\@Ergebnis,"\nErgebnis");  #exit 7;
                #&Dprint("PerlErrorMessage: $PerlErrorMessage"); # exit 7;
  &ProcessPandocExitCode($PandocExitCode,$PandocCall) if ( $PandocExitCode != 0 );

  if ( scalar(@Ergebnis) < 1 ) {
    $Message = "Aufruf von Pandoc ($cc$PandocCall$cr) lieferte keine Ausgaben zurück.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   Pandoc ab Version $O{'PandocTestversion'} soll zur Umwandlung von .docx in HTML-Form verwendet werden.";
      if ( $O{'details'} > 1 ) {
        $Message .= "\n                   Pandoc konnte mit dem Kommando »$cc$PandocCall$cr« aufgerufen werden, hat aber keine Ausgaben zurückgeliefertr.";
        $Message .= "\n                   Maßnahmen: In Kommandozeile (Eingabeaufforderung, Konsole, Terminal prüfen,";
        $Message .= "\n                   ob der Aufruf »$cc$PandocCall$cr« zumindest eine Zeile Ausgaben erzeugt und in der";
        $Message .= "\n                   ersten Zeile die Version ausgibt.";
        } 
      }
    &Error($Message); # &Exit(1);
    } # pandoc --version: Ohne Ausgaben

  chomp(@Ergebnis);
  if ( $O{'details'} > 4 ) {
    print("Ausgabe(n) von »$cc$PandocCall$cr«:\n");
    foreach $t (@Ergebnis) {
      print("    $t\n");
      }
    }
  $Firstline = $Ergebnis[0];
                #&Dprint("Firstline: $Firstline"); # exit 7;
  if ( $Firstline !~ /pandoc +([0-9]+\.[0-9]+)(.*)/i ) {
    $Message = "Erste Zeile der Ausgabe des Pandoc-Aufrufs ($cc$PandocCall$cr) hat nicht das Format einer Versionsangabe.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   Wahrscheinlich verändertes Verhalten von Pandoc. Skript $ScriptName sollte angepasst werden.";
      $S{'PandocVersion'} = "nicht ermittelbar";
      &Warn($Message);
      return;
      }
    } # Keine Pandoc-Versionsangabe
  $PandocVersion = $1;
  $PandocVersionsrest = $2;

  $S{'PandocVersion'} = $PandocVersion . $PandocVersionsrest;
  if ( $PandocVersion !~ /([0-9]+)\.([0-9]+)/ ) {
    $Message = "$ScriptName: Internal error PruefePandocAufruf: Zweiter Test der Pandoc-Version gescheitert.";
    &Error($Message); # &Exit(1);
    }
  $Hauptversion = $1;
  $Unterversion = $2;
  if ( $O{'PandocTestversion'} !~ /([0-9]+)\.([0-9]+)/ ) {
    $Message = "$ScriptName: Internal error PruefePandocAufruf: O{'PandocTestversion'} falsch formatiert.";
    &Error($Message); # &Exit(1);
    }
  $TestHauptversion = $1;
  $TestUnterversion = $2;
    $Message = "Aufgerufene Pandoc-Version ($S{'PandocVersion'}) ist älter als die, mit der $ScriptName entwickelt und getestet wurde ($O{'PandocTestversion'})";
    if ( $Hauptversion < $TestHauptversion ) {
      &Warn($Message);
      }
    if ( ($Hauptversion == $TestHauptversion) and ($Unterversion < $TestUnterversion) ) {
      &Warn($Message);
      }

  if ( $O{'details'} > 3 ) { print("Verwemdete ${co}Pandoc-Version:$cr $S{'PandocVersion'}\n"); }
  return;
  } #sub PruefePandocAufruf

sub CheckBaseDir #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &CheckBaseDir();
    # Prüft ob das Basisverzeichnis $S{'BaseDir'} die erforderlichen Berechtigungen hat
    # Falls irgenndetwas nicht so ist, wie es sein soll, wird eine geeignete Fehlermeldung ausgegeben und die
    # Ausführung mit einem Fehlercode beendet.
  my($DirName) = $S{'BaseDir'};
  my($Message) = "$ScriptName: Internal error CheckBaseDir: Should never be printed";

  if ( not (-e $DirName) ) { # Seltsam: Aufrufverzeichnis soll nicht existieren
    $Message = "Aufrufverzeichnis »$cf$DirName$cr« existiert gemäß Betriebssystemabfrage nicht.";
    $Message .= &AddM1() . &AddE2;
    &Error($Message); # &Exit(1);
    } # Seltsam: Aufrufverzeichnis soll nicht existieren

  if ( not (-d $DirName) ) { # Seltsam: Aufrufverzeichnis soll kein Verzeichnis sein
    $Message = "Aufrufverzeichnis »$cf$DirName$cr« ist gemäß Betriebssystemabfrage kein Verzeichnis.";
    $Message .= &AddM1() . &AddE2;
    &Error($Message); # &Exit(1);
    } # Seltsam: Aufrufverzeichnis soll kein Verzeichnis sein

  if ( not (-r $DirName) ) { # Seltsam: Aufrufverzeichnis soll nicht lesbar sein
    $Message = "Aufrufverzeichnis »$cf$DirName$cr« ist gemäß Betriebssystemabfrage nicht lesbar.";
    $Message .= &AddM1() . &AddE2;
    &Error($Message); # &Exit(1);
    } # Seltsam: Aufrufverzeichnis soll nicht lesbar sein

  if ( not (-w $DirName) ) { # Aufrufverzeichnis nicht beschreibbar
    $Message = "Aufrufverzeichnis $DirName$cr« nicht beschreibbar.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   In »$cf$DirName$cr« werden Hilfs- und Ergebnisdateien geschrieben.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: Schreibrechte für »$cf$DirName$cr« erteilen.";
      }
    $Message .= &AddE3($DirName);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n                   Dazu muss in das Verzeichnis »$cf$DirName$cr« geschrieben werden können.";
      }
    &Error($Message); # &Exit(1);
    } #  Aufrufverzeichnis nicht beschreibbar

  if ( not (-x $DirName) ) { # Aufrufverzeichnis nicht durchsuchbar
    $Message = "Dateinamen im Aufrufverzeichnis »$cf$DirName$cr« nicht ermittelbar.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   Die Dateinamen in »$cf$DirName$cr« müssen ermittelbar sine, damit diese";
      $Message .= "\n                   verarbeitet werden können.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: Suchrechte (Unix usw: x) für »$cf$DirName$cr« erteilen.";
      }
    $Message .= &AddE3($DirName);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n                   Dazu sollte der Inhalt des Verzeichnisses »$cf$DirName$cr« ermittelt werden können.";
      }
    &Error($Message); # &Exit(1);
    } #  Aufrufverzeichnis nicht durchsuchbar

  return;
  } # CheckBaseDir

sub CheckInputDir #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage:  &CheckInputDir($DirName);
    # Prüft, ob $DirName ein les-, schreib und scanbares Verzeichnis im aktuellen Arbeitsverzeichnis ist.
    # Falls irgenndetwas nicht so ist, wie es sein soll, wird eine geeignete Fehlermeldung ausgegeben und die
    # Ausführung mit einem Fehlercode beendet.
  my($DirName) = @_;
  my($CurrentDir) = File::Spec->rel2abs(".","");
  my($Message) = "Internal error CheckInputDir: Should never be printed";

  if ( not (-e $DirName) ) { # Verzeichnisname im aktuellen Verzeichnis nicht gefunden
    $Message = "Verzeichnis »$cf$DirName$cr« in »$cf$CurrentDir$cr« nicht gefunden.";
    if ( $O{'details'} > 0 ) { $Message .= $cr;
      $Message .= "\n                   »$cf$DirName$cr« soll aus Google Docs heruntergeladene Begriffe als .docx-Dateien enthalten.";
      }
    $Message .= &AddH1(1,$DirName);
    &Error($Message); # &Exit(1);
    } #  Verzeichnisnamen im aktuellen Verzeichnis nicht gefunden

  if ( not (-d $DirName) ) { # Dateinamen vorhanden, ist aber unerwarteterweise kein Verzeichnis
    $Message = "Dateiname »$cf$DirName ist in »$cf$CurrentDir$cr« vorhanden, aber kein Verzeichnis.";
    if ( $CurrentDir eq $S{'BaseDir'} ) { # In BaseDir 
      if ( $O{'details'} > 0 ) {
        $Message .= $cr;
        $Message .= "\n                   »$cf$DirName$cr« soll ein Verzeichnis sein, das aus Google Docs";
        $Message .= "\n                   heruntergeladene Begriffe als .docx-Dateien enthält.";
        }
      if ( $O{'details'} > 1 ) {
        $Message .= "\n    Maßnahmen:     »$cf$DirName$cr« umbennen, Begriffe aus Google Docs herunterladen und auspacken.";
        }
    $Message .= &AddH1(2,$DirName);
      } # In BaseDir
    else { # In Unterverzeichnis
      if ( $O{'details'} > 1 ) {
        $Message .= "\n    Maßnahmen:     Prüfen, ob der Download der Google Docs-Dateien oder das entzippen sich anders verhält.";
        $Message .= "\n                   Verzeichnis »$cf$O{'InputDir'}$cr« in »$cf$S{'BaseDir'}$cr« löschen und von Google Docs";
        $Message .= "\n                   neu herunterladen.";
        $Message .= "\n                   Falls das nicht hilft, ist eine detaillierte Fehleranalyse erforderlich.";
        }
    $Message .= &AddH1(2,$DirName);
      } # In Unterverzeichnis
    &Error($Message); # &Exit(1);
    } #  Dateinamen vorhanden, ist aber unerwarteterweise kein Verzeichnis

  if ( not (-r $DirName) ) { # Eingabeverzeichnisnamen gefunden: nicht lesbar
    $Message = "Dateiname »$cf$DirName$cr« in »$cf$CurrentDir$cr« nicht lesbar.";
    if ( $O{'details'} > 0 ) {
      $Message .= $cr;
      $Message .= "\n                   »$cf$DirName$cr« sollte ein lesbares Verzeichnis in »$cf$CurrentDir$cr« sein, das die aus";
      $Message .= "\n                   Google Docs heruntergeladene Begriffe als .docx-Dateien enthält.";
      }
    if ( $O{'details'} > 1 ) {
      $Message .= "\n         Maßnahme: Leserechte für »$cf$DirName$cr« erteilen.";
      }
    &Error($Message); # &Exit(1);
    } #  Eingabeverzeichnisnamen gefunden: nicht lesbar

  if ( not (-w $DirName) ) { # Eingabeverzeichnisnamen gefunden: nicht beschreibbar
    $Message = "Dateiname »$cf$DirName$cr« in »$cf$CurrentDir$cr« nicht beschreibbar.";
    if ( $O{'details'} > 0 ) {
