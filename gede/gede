sub AnalysiereBegriffsId #>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  { # Usage: ($Status,$View) = &AnalysiereBegriffsID($BegriffsId);
    # Prüft, ob $BegriffsId gemäß Kodierrichtlinie aufgebaut ist.
    # Wenn nicht, wird FALSE zurückgegeben und eine entsprechende Meldung ausgegeben, ansonsten TRUE.
    # Zusätzlich wird entweder die in $BegriffsId gefundene View als Zeichenkette zurückgegeben oder 
    # eine leere Zeichenkette
    # Befüllt %ViewsAusBegriffsIds.
  my($Id) = @_;
  my($Message) = "$ScriptName: Internal error AnalysiereBegriffsId: Should never be printed";
  my($View) = "";

  if ( $Id !~ $O{'guteZeichen'} ) {
    $Message = "Begriffs-Id »$co$Id$cr« enthält gemäß Kodierrichtlinie unerwünschte Zeichen, d. h.";
    $Message .= "\n                   Zeichen nicht aus $co$O{'guteZeichenT'}$cr";
    $Message .= &AddMPF(1);
    &Error($Message); # &Exit(1);
    } # nicht-gute Zeichen in Id

  if ( $Id !~ /_/ ) {
    return (TRUE,"");
    } # Keine View

  if ( $Id =~ /__/ ) {
    $Message = "Begriffs-Id »$co$Id$cr« enthält zwei unmittelbar aufeinander folgende Unterstriche (__),";
    $Message .= "\n                   d. h. eine View ohne Inhalt. Begriff ${cw}nicht übernommen$cr.";
    $Message .= &AddM2(1);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n      Erläuterung: Mehrfach definierte Begriffe werden in der Begriffs-Id eindeutig gemacht,";
      $Message .= "\n                   indem in der Begriffs-Id nach einem Unterstrich (_) die (Zusatz-) View";
      $Message .= "\n                   angegeben wird, in der diese aufgeführt werden sollen.";
      $Message .= "\n                   Diese View kann nach jeweils einem Unterstrich weitere Unterviews enthalten.";
      $Message .= "\n                   Alle diese Views müssen mindestens ein zulässiges Zeichen enthalten.";
      }
    &Warn($Message);
    return (FALSE,"");
    } # __ in Id

  if ( $Id =~ /_$/ ) {
    $Message = "Begriffs-Id »$co$Id$cr« hat als letztes Zeichen einen Unterstrich (_), d. h. eine View ohne";
    $Message .= "\n                   Inhalt: Begriff ${cw}nicht übernommen$cr.";
    $Message .= &AddM2(1);
    if ( $O{'details'} > 2 ) {
      $Message .= "\n      Erläuterung: Mehrfach definierte Begriffe werden in der Begriffs-Id eindeutig gemacht,";
      $Message .= "\n                   indem in der Begriffs-Id nach einem Unterstrich (_) die (Zusatz-) View";
      $Message .= "\n                   angegeben wird, in der diese aufgeführt werden sollen.";
      $Message .= "\n                   Diese View kann nach jeweils einem Unterstrich weitere Unterviews enthalten.";
      $Message .= "\n                   Alle diese Views müssen mindestens ein zulässiges Zeichen enthalten.";
      }
    &Warn($Message);
    return (FALSE,"");
    } # Id endet mit Unterstrich

  $Id =~ /_(.*)$/;
  $View = $1;
  &PushToHash(\%ViewsAusBegriffsIds,$View,$Id);
  return (TRUE,$View);
  } # sub AnalysiereBegriffsId #<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

